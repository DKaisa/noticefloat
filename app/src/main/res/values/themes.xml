<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NoticeFloat" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <!-- 强制 Date/Time Picker 亮色，避免夜间模式白字白底 -->
        <item name="android:datePickerDialogTheme">@style/NoticeFloat.PickerDialog</item>
        <item name="android:timePickerDialogTheme">@style/NoticeFloat.PickerDialog</item>
        <item name="android:editTextStyle">@style/NoticeFloat.EditText</item>
    </style>

    <style name="Theme.NoticeFloat.HalfScreen" parent="Theme.NoticeFloat">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="NoticeFloat.PickerDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="NoticeFloat.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
